Mplus VERSION 8.3 (Mac)
MUTHEN & MUTHEN
06/10/2026  10:37 PM

INPUT INSTRUCTIONS

   TITLE: Parental Control and Sleep Anxiety

    Data:
        FILE IS parent_child_data_Mplus.dat;

    VARIABLE:
        NAMES ARE P_ID F_ID c_id c_sex cage edu p_mh sep_s s_len psych_c pcontrol
                  pc_neg bully racism life_qua
                  mcatt fcatt p_supp peer_supp sch_supp tea_supp c_dep c_anx sleep
                  sui_12 sui_13 er_cog er_exp cope_pe cope_pd cope_ee cope_ed bully_c
                  racism_c fcatt_c mcatt_c p_supp_c pe_sup_c s_supp_c t_sup_c bullyps
                  bullpes bullysc bullyts bullyma bullyfa rac_ps rac_pes rac_sc rac_ts
                  rac_ma rac_fa psych_cc pc_neg_c er_cog_c er_exp_c conercog conerexp
                  negercog negerexp negercpe negerced female cope;

         MISSING = .;

        USEVARIABLES ARE cage edu p_mh  pc_neg er_cog er_exp
                         cope_pe cope_pd cope_ee
                         life_qua female
                         negercog  negerexp negcope;
                         !c_anx conercog conerexp
                         ! psych_c  negercpe negerced psych_c cope_ed
                         ! negerced er_exp negerexp

        GROUPING IS sep_s (1=separated 2=non-separated);

   DEFINE:

        negercog = pc_neg * er_cog;
        negerexp = pc_neg * er_exp;
        negcope = pc_neg * cope;

   ANALYSIS:

          ESTIMATOR = MLR;

   MODEL:
        cope BY cope_pe@1 cope_pd cope_ee;

        !life_qua ON psych_c;
        life_qua ON pc_neg;

        life_qua ON er_cog;
        life_qua ON er_exp;
       ! life_qua ON er_exp;

       ! c_anx ON psych_c;
      !  c_anx ON pc_neg;

        life_qua ON cope;
      ! life_qua ON cope_ed;

       ! c_anx ON er_cog;
       ! c_anx ON er_exp;

        life_qua ON negercog;
        life_qua ON negerexp;
        life_qua ON negcope;

       ! c_anx ON conercog;
       ! c_anx ON conerexp;

       ! life_qua ON negercog;
       ! life_qua ON negerexp;

       ! c_anx ON negercog;
       ! c_anx ON negerexp;



       life_qua ON female;
       life_qua ON cage;
       life_qua ON edu;
       life_qua ON p_mh;

       !pc_neg WITH er_cog;
       pc_neg WITH er_exp;
       er_cog WITH er_exp;
       !cope WITH pc_neg;
       cope WITH er_cog;
       cope WITH er_exp;

       NEGERCOG WITH ER_COG;
       NEGERCOG WITH ER_EXP;
       NEGEREXP WITH ER_COG;
       NEGEREXP WITH ER_EXP;




    OUTPUT:
        cinterval;
        STANDARDIZED;
        MODINDICES(10);




